# OPTIONAL. Writable directory for published asset revisions. May be relative to working directory.
# Example local value: .runtime/publications
# Owner: consumer application host. Sensitive: no.
APPLICATION_PUBLICATIONS_ROOT=.runtime/publications

# OPTIONAL. Runtime environment (local | production). Default is controlled by Atlanticus WebSettings.
# Owner: consumer application host. Sensitive: no.
ATLANTICUS_ENVIRONMENT=local
