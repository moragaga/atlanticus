# Plantilla de configuración del proceso.
# Los valores entre <...> deben reemplazarse antes de ejecutar.
# En local, .env participa en la resolución. En dev/uat/stg/prd la configuración desplegada
# proviene del manifiesto/Key Vault y ENVIRONMENT debe ser inyectado por el proceso.

# Ambiente de ejecución. Valores del backend: local, dev, uat, stg, prd.
# Un archivo .env solo puede seleccionar local; los ambientes desplegados deben inyectarse al proceso.
ENVIRONMENT=local

# Abreviatura de la compañía usada para construir la configuración de Key Vault en despliegue.
# No participa en la lógica funcional local del proceso.
COMPANY_ABREV=<company-abrev>

# Abreviatura del producto usada junto con compañía y ambiente para resolver Key Vault en despliegue.
# No participa en la lógica funcional local del proceso.
PRODUCT_ABREV=<product-abrev>

# Identidad de la instancia local del proceso PI Web API.
# CURRENT desplegado: operational-data-pi.
APPLICATION=operational-data-pi-local

# Ruta raíz usada por Atlanticus para datos, logs y estado de runtime de esta aplicación.
# Debe ser siempre absoluta.
# Local sin Docker: reemplazar por una ruta absoluta escribible del usuario que ejecuta el proceso.
# Docker/despliegue: corresponde al filesystem del contenedor; el valor CURRENT desplegado es /app/volumen.
VOLUMEN_PATH=<absolute-local-volume-path>

# URL base del PI Web API. Debe apuntar a la instancia HTTP/HTTPS que atenderá las consultas.
PI_WEB_API_BASE_URL=<pi-web-api-base-url>

# Nombre del PI Data Archive/servidor que PI Web API debe consultar.
PI_WEB_API_SERVER=<pi-server>

# Usuario de autenticación Basic para PI Web API.
# Es sensible; en despliegue CURRENT se resuelve desde Key Vault.
PI_WEB_API_USERNAME=<pi-web-api-username>

# Password de autenticación Basic para PI Web API.
# Es sensible; en despliegue CURRENT se resuelve desde Key Vault.
PI_WEB_API_PASSWORD=<pi-web-api-password>

# Timeout de establecimiento de conexión HTTP, en segundos. Debe ser un entero positivo.
# Default/CURRENT: 5.
PI_WEB_API_CONNECT_TIMEOUT_SECONDS=5

# Timeout de lectura HTTP, en segundos. Debe ser un entero positivo.
# Default/CURRENT: 30.
PI_WEB_API_READ_TIMEOUT_SECONDS=30

# Timeout de escritura HTTP, en segundos. Debe ser un entero positivo.
# Default/CURRENT: 30.
PI_WEB_API_WRITE_TIMEOUT_SECONDS=30

# Timeout para obtener una conexión desde el pool HTTP, en segundos. Debe ser un entero positivo.
# Default/CURRENT: 5.
PI_WEB_API_POOL_TIMEOUT_SECONDS=5

# Tamaño máximo aceptado para una respuesta HTTP, en bytes.
# Debe ser un entero positivo. Default/CURRENT: 67108864 (64 MiB).
PI_WEB_API_MAX_RESPONSE_BYTES=67108864

# Valida certificados TLS en conexiones HTTPS.
# Booleano. Default/CURRENT: true.
PI_WEB_API_VERIFY_TLS=true

# Permite explícitamente HTTP sin TLS cuando el endpoint lo requiere.
# Booleano. Default/CURRENT: false.
PI_WEB_API_ALLOW_INSECURE_HTTP=false

# Máximo de paths resueltos por operación de búsqueda de puntos.
# Debe ser un entero positivo. Default/CURRENT: 100.
PI_WEB_API_POINTS_MAX_PATHS=100

# Máximo de WebIDs por solicitud interpolated.
# Debe ser un entero positivo. Default/CURRENT: 200.
PI_WEB_API_INTERPOLATED_MAX_WEB_IDS=200

# Máximo de WebIDs por solicitud recorded.
# Debe ser un entero positivo. Default/CURRENT: 100.
PI_WEB_API_RECORDED_MAX_WEB_IDS=100

# Máximo lookback permitido durante recovery, en segundos.
# Debe ser un entero positivo. Default/CURRENT: 3600.
PI_WEB_API_MAX_RECOVERY_LOOKBACK_SECONDS=3600

# Tamaño máximo de cada ventana de recovery, en segundos.
# Debe ser positivo y no puede superar PI_WEB_API_MAX_RECOVERY_LOOKBACK_SECONDS.
# Default/CURRENT: 3600.
PI_WEB_API_MAX_RECOVERY_WINDOW_SECONDS=3600

# Máximo de solicitudes interpolated ejecutadas en paralelo.
# Rango permitido: 1 a 3. Default/CURRENT: 3.
PI_WEB_API_INTERPOLATED_MAX_PARALLEL_REQUESTS=3

# Máximo de puntos de datos permitido por ejecución/operación del proceso.
# Debe ser un entero positivo. Default/CURRENT: 150000.
PI_WEB_API_MAX_DATA_POINTS=150000

# Habilita la persistencia local de eventos de observabilidad en archivos.
# Valores booleanos aceptados por runtime: 1/true/yes/on y 0/false/no/off. Default efectivo: true.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true

# Modo de observabilidad Azure. Valores: off, preview, export.
# Local CURRENT: off. En los manifests desplegados CURRENT se usa export.
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off

# Perfil de detalle enviado a Azure. Valores: slim, diagnostic.
# slim es el perfil CURRENT y el default de la extensión Azure.
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim

# Connection string de Application Insights.
# Solo se utiliza y pasa a ser obligatoria cuando ATLANTICUS_AZURE_OBSERVABILITY_MODE=export.
# Es sensible; en despliegue CURRENT se resuelve desde Key Vault.
APPLICATION_INSIGHTS_CONNECTION_STRING=
