# pi — plantilla local documentada de Operational Data (atlanticus:main).
# Copiar a .env solo para ejecución LOCAL; reemplazar placeholders <...>.
# Para dev/uat/stg/prd, la plataforma inyecta ENVIRONMENT; los valores se
# resuelven desde secrets.json / Key Vault, NO desde el archivo .env local.
# secrets.detail.json es plantilla de despliegue, NO un secreto listo para producción.
# config.detail.json contiene cron/recursos del job Azure, distintos del polling interno.

# 01. Ambiente y Key Vault
# El archivo .env solo selecciona local. dev/uat/stg/prd se inyecta mediante la plataforma; nunca poner ENVIRONMENT en secrets.json.
ENVIRONMENT=local
# Abreviatura de compañía para resolver la identidad de Key Vault cuando se usan secretos; sin default.
COMPANY_ABREV=<company-abrev>
# Abreviatura del producto para resolver la identidad de Key Vault; sin default.
PRODUCT_ABREV=<product-abrev>

# 02. Identidad funcional y volumen
# Ruta raíz absoluta del volumen compartido. En contenedor distribuido actual: /app/volumen; sin default.
VOLUMEN_PATH=<absolute-shared-volume-path>
# Identidad funcional que define la raíz de datos y estado del volumen. Conservar referencias productor/consumidor consistentes; sin default.
APPLICATION=operational-data-pi-local

# 03. Conexiones, productores y parámetros de origen
# URL base del servicio PI Web API; usar HTTPS en producción.
# Obligatorio o condicional según descripción; sustituir el placeholder antes de usar.
PI_WEB_API_BASE_URL=<pi-web-api-base-url>
# Servidor PI identificado en la consulta PI Web API; debe existir en el proveedor.
# Obligatorio o condicional según descripción; sustituir el placeholder antes de usar.
PI_WEB_API_SERVER=<pi-server>
# Nombre de usuario sensible para autenticación BASIC a PI Web API; Key Vault en producción.
# Obligatorio o condicional según descripción; sustituir el placeholder antes de usar.
PI_WEB_API_USERNAME=<pi-web-api-username>
# Contraseña sensible para autenticación BASIC a PI Web API; Key Vault en producción.
# Obligatorio o condicional según descripción; sustituir el placeholder antes de usar.
PI_WEB_API_PASSWORD=<pi-web-api-password>
# Timeout HTTP de conexión PI Web API en segundos. Default de código: 5.
PI_WEB_API_CONNECT_TIMEOUT_SECONDS=5
# Timeout HTTP de lectura PI Web API en segundos. Default de código: 30.
PI_WEB_API_READ_TIMEOUT_SECONDS=30
# Timeout HTTP de escritura PI Web API en segundos. Default de código: 30.
PI_WEB_API_WRITE_TIMEOUT_SECONDS=30
# Timeout HTTP de espera del pool PI Web API en segundos. Default de código: 5.
PI_WEB_API_POOL_TIMEOUT_SECONDS=5
# Máximo de bytes por respuesta PI Web API. Default de código: 67108864 (64 MiB).
PI_WEB_API_MAX_RESPONSE_BYTES=67108864
# Verificación TLS PI Web API. Default de código: true; mantener true en producción.
PI_WEB_API_VERIFY_TLS=true
# Permitir transporte HTTP PI Web API. Default de código: false; no habilitar en producción.
PI_WEB_API_ALLOW_INSECURE_HTTP=false
# Máximo de rutas en consulta de puntos PI. Default de código: 100.
PI_WEB_API_POINTS_MAX_PATHS=100
# Máximo de WebIds interpolados por solicitud. Default de código: 200.
PI_WEB_API_INTERPOLATED_MAX_WEB_IDS=200
# Máximo de WebIds registrados por solicitud. Default de código: 100.
PI_WEB_API_RECORDED_MAX_WEB_IDS=100
# Máxima antigüedad para recuperación PI en segundos. Default de código: 3600.
PI_WEB_API_MAX_RECOVERY_LOOKBACK_SECONDS=3600
# Tamaño de ventana de recuperación PI en segundos. Default: 3600; nunca mayor que LOOKBACK.
PI_WEB_API_MAX_RECOVERY_WINDOW_SECONDS=3600
# Solicitudes interpoladas PI simultáneas. Default de código: 3; rango validado 1..3.
PI_WEB_API_INTERPOLATED_MAX_PARALLEL_REQUESTS=3
# Máximo de puntos de datos PI por operación. Default de código: 150000.
PI_WEB_API_MAX_DATA_POINTS=150000

# 04. Ejecución y control
# Salvaguarda administrativa: true impide nuevas ejecuciones. Default de código false. Mantener false salvo detención aprobada.
ATLANTICUS_JOB_EXECUTION_DISABLED=false
# Espera entre iteraciones del proceso en segundos; no es el schedule del job Azure. El default de código es 0 para SQL/PI/NotPII; la plantilla local propone 1.
POLL_INTERVAL_SECONDS=1

# 05. Observabilidad (independiente del dominio de datos)
# Habilita logs locales en archivos, independientes de la telemetría de Azure. Default de código true.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true
# Controla telemetría Azure: off | preview | export. Default de código off. export necesita conexión de Application Insights.
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off
# Detalle de telemetría: slim | diagnostic. Opcional; perfil efectivo habitual slim.
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim
# Cadena sensible de Application Insights. Requerida cuando el modo Azure efectivo es export; usar Key Vault en despliegue.
APPLICATION_INSIGHTS_CONNECTION_STRING=

# Los defaults no declarados en secrets.json se resuelven en código.
# No versionar credenciales ni copiar literalmente los placeholders a producción.
