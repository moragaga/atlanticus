# Plantilla de configuración local del proceso.
# Copiar este archivo a .env antes de ejecutar localmente.
# Los valores entre <...> deben reemplazarse antes de ejecutar.
# En local, .env participa en la resolución de configuración.
# En dev/uat/stg/prd, la configuración se resuelve desde el manifiesto/Key Vault y
# ENVIRONMENT debe ser inyectado por la plataforma.

# Ambiente de ejecución. Valores admitidos por el backend: local, dev, uat, stg, prd.
# Un archivo .env solo puede seleccionar local; los ambientes desplegados deben
# inyectar ENVIRONMENT al proceso.
ENVIRONMENT=local

# Abreviatura de la compañía usada únicamente para construir la identidad de Key Vault
# cuando un despliegue necesita resolver secretos. No forma parte de la configuración
# funcional resuelta del proceso y no tiene efecto en ejecución local.
COMPANY_ABREV=<company-abrev>

# Abreviatura del producto usada junto con compañía y ambiente para resolver Key Vault.
# No forma parte de la configuración funcional resuelta del proceso y no tiene efecto local.
PRODUCT_ABREV=<product-abrev>

# Identidad de la instancia local de Remanentes.
# CURRENT desplegado: operational-data-remanentes.
APPLICATION=operational-data-remanentes-local

# Ruta raíz usada por Atlanticus para datos, logs y estado de runtime de esta aplicación.
# Debe ser absoluta. En ejecución local sin Docker debe reemplazarse por una ruta
# escribible del usuario. Docker/simulación/distribución puede sobrescribirla con
# /app/volumen, que es el valor CURRENT del contenedor.
VOLUMEN_PATH=<absolute-local-volume-path>

# Connection string del Storage Account desde el que Remanentes consume su fuente.
# Es obligatoria y sensible. CURRENT desplegado: resuelta desde Key Vault.
STORAGE_ACCOUNT_CONNECTION_STRING_REMANENTES=<storage-connection-string>

# Nombre del container Storage usado por Remanentes.
# Es obligatorio y no tiene default de código. Plantilla local y CURRENT desplegado: dataproduct.
STORAGE_ACCOUNT_CONTAINER_NAME_REMANENTES=dataproduct

# Zona horaria IANA usada para interpretar timestamps de la fuente.
# Debe ser válida. Default de código, plantilla local y CURRENT desplegado: America/Santiago.
REMANENTES_SOURCE_TIMEZONE=America/Santiago

# Espera interna cuando no hay trabajo nuevo, en segundos.
# Debe ser un entero positivo. Default de código, plantilla local y CURRENT desplegado: 30.
REMANENTES_IDLE_SECONDS=30

# Habilita o deshabilita la persistencia de eventos de observabilidad en archivos.
# Valores booleanos aceptados: 1/true/yes/on y 0/false/no/off.
# Default de código: true. Plantilla local: true. CURRENT desplegado: true.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true

# Modo de observabilidad Azure. Valores: off, preview, export.
# Default de código: off. Plantilla local: off. CURRENT desplegado: export.
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off

# Perfil de detalle enviado a Azure. Valores: slim, diagnostic.
# Default efectivo de la extensión Azure: slim.
# Plantilla local y CURRENT desplegado: slim.
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim

# Connection string de Application Insights. Es sensible.
# La extensión Azure la requiere cuando el modo efectivo es export.
# CURRENT desplegado: resuelta desde Key Vault.
# En local con mode=off puede permanecer vacía.
APPLICATION_INSIGHTS_CONNECTION_STRING=

# Salvaguarda administrativa para impedir nuevas ejecuciones del proceso.
# Ausente equivale a false. Si se establece en true, la imagen oficial termina
# con exit 0 antes de iniciar Python y Atlanticus Runtime tampoco ejecuta el job.
# ATLANTICUS_JOB_EXECUTION_DISABLED=false
