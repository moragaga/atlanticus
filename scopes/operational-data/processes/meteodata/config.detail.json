{
  "configuration": {
    "replicaTimeout": 190,
    "replicaRetryLimit": 0,
    "triggerType": "Schedule",
    "scheduleTriggerConfig": {
      "cronExpression": "*/5 * * * *",
      "parallelism": 1
    }
  },
  "template": {
    "container": {
      "name": "meteodata-service",
      "resources": {
        "cpu": 0.5,
        "memory": "1Gi"
      }
    }
  }
}
