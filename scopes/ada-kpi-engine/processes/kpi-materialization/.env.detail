# Plantilla local: copiar a .env. El despliegue remoto inyecta su configuración.
ENVIRONMENT=local

# Identidad de la instancia local de KPI Materialization.
APPLICATION=ada-kpi-materialization-local

# Volumen compartido con Latest y Timeseries Delivery.
# Debe ser una ruta absoluta.
VOLUMEN_PATH=<absolute-shared-volume-path>

# Intervalo genérico del runtime entre iteraciones normales del proceso.
# Default actual de KPI Materialization: 30 segundos.
POLL_INTERVAL_SECONDS=30

# config/connections.json NO contiene endpoints, database names ni credenciales.
# Contiene los NOMBRES de las variables que deben resolverse desde este .env
# en local o desde secrets.json / Key Vault en ambientes desplegados.
#
# Ejemplo correspondiente a config/connections.detail.json:
#   "endpoint_var": "EXAMPLE_TOOL_COSMOS_ENDPOINT"
#   "database_var": "EXAMPLE_TOOL_COSMOS_DATABASE"
#   "credential_var": "EXAMPLE_TOOL_COSMOS_KEY"
#
# Para cada Tool real, reemplazar EXAMPLE_TOOL por las variables declaradas
# exactamente en config/connections.json y agregar sus valores aquí.
EXAMPLE_TOOL_COSMOS_ENDPOINT=http://localhost:8081
EXAMPLE_TOOL_COSMOS_DATABASE=<cosmos-database>
EXAMPLE_TOOL_COSMOS_KEY=<local-cosmos-key>

COMPANY_ABREV=<company-abrev>
PRODUCT_ABREV=<product-abrev>

ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=
APPLICATION_INSIGHTS_CONNECTION_STRING=
