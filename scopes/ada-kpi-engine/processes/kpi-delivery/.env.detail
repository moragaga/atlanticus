# kpi-delivery — plantilla LOCAL de configuración; no es un manifiesto productivo.
# Copiar a .env solo en ejecución local. Variables con <...> requieren sustitución.
# En dev/uat/stg/prd ENVIRONMENT lo inyecta la plataforma y el proceso utiliza
# secrets.json / Key Vault; no se leen los valores de esta plantilla .env.detail.
# La configuración desplegada de referencia está en secrets.detail.json.
# config.detail.json define el schedule del job Azure, NO el polling interno.
# config.detail.json: configuration.replicaTimeout = límite de ejecución Azure; replicaRetryLimit = reintentos Azure; scheduleTriggerConfig.cronExpression = cron; parallelism = simultaneidad; template.container.resources = CPU/memoria. Estos campos NO son variables del .env ni tienen defaults del proceso.

# 01. Ambiente y Key Vault
# Ambiente; en despliegue se inyecta por plataforma, nunca en secrets.json.
# Valores: local | dev | uat | stg | prd. sin default; .env solo para local.
ENVIRONMENT=local
# Identificador de compañía para localizar Key Vault cuando hay secretos remotos.
# Valores: texto sin espacios laterales. sin default; confirmar identidad.
COMPANY_ABREV=<company-abrev>
# Identificador de producto para localizar Key Vault cuando hay secretos remotos.
# Valores: texto sin espacios laterales. sin default; confirmar identidad.
PRODUCT_ABREV=<product-abrev>

# 02. Identidad funcional y volumen
# Directorio absoluto compartido que contiene las carpetas por APPLICATION; debe estar montado en todos los consumidores.
# Valores: ruta absoluta. obligatoria; sin default; contenedor objetivo /app/volumen.
# En secrets.detail.json (desplegado): /app/volumen
VOLUMEN_PATH=<absolute-shared-volume-path>
# Raíz funcional del volumen y de la observabilidad. Misma identidad agrupa datos; los job_key siguen separados.
# Valores: segmento seguro [A-Za-z0-9_.-]. obligatoria; sin default.
# En secrets.detail.json (desplegado): ada-kpi-delivery
# Compartir este valor entre jobs no fusiona leases ni job_key.
APPLICATION=ada-kpi-delivery-local

# 03. Productores y orígenes
# APPLICATION del productor KPI Runtime; puede ser igual a APPLICATION si se comparte raíz funcional.
# Valores: identidad del productor. obligatoria; sin default.
# En secrets.detail.json (desplegado): ada-kpi-runtime
KPI_RUNTIME_APPLICATION=ada-kpi-runtime-local

# 04. Ejecución y control
# Barrera administrativa: true deshabilita nuevas ejecuciones.
# Valores: true | false. default de código false.
ATLANTICUS_JOB_EXECUTION_DISABLED=false
# Intervalo interno de polling (Materialization > 0; Delivery >= 0); distinto al cron del job.
# Valores: segundos, numérico. default de código 30 en Materialization o 1 en Delivery.
POLL_INTERVAL_SECONDS=1
# Máximo de Tools publicadas simultáneamente hacia Cosmos.
# Valores: entero > 0. default de código 2.
KPI_DELIVERY_MAX_WORKERS=2

# 05. Conexiones Cosmos
# Endpoint de Cosmos de Tool (nombre definido en config/connections.json).
# Valores: URL Cosmos. obligatoria por conexión declarada.
# En secrets.detail.json (desplegado): <cosmos-endpoint>
# Ejemplo de Tool: cambiar variables y conexión según config/connections.json.
EXAMPLE_TOOL_COSMOS_ENDPOINT=http://localhost:8081
# Base de datos Cosmos de Tool, preexistente.
# Valores: nombre Cosmos DB. obligatoria por conexión declarada.
EXAMPLE_TOOL_COSMOS_DATABASE=<cosmos-database>
# Credencial Cosmos de Tool; no guardar valor real en Git.
# Valores: secreto de Key Vault en desplegado. obligatoria por conexión declarada.
# En despliegue: referencia Key Vault; no utilizar credenciales locales.
EXAMPLE_TOOL_COSMOS_KEY=<local-cosmos-key>

# 06. Observabilidad
# Logs de archivo locales separados de la telemetría Azure.
# Valores: true | false. default de código true.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true
# off sin exportación; preview valida preparación; export requiere connection string.
# Valores: off | preview | export. default de código off.
# En secrets.detail.json (desplegado): export
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off
# Perfil de detalle de telemetría.
# Valores: slim | diagnostic. opcional; efectivo slim.
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim
# Connection string sensible de Application Insights; requerida si el modo efectivo es export.
# Valores: cadena de conexión. opcional en off/preview; Key Vault en export.
# En despliegue: referencia Key Vault; no utilizar credenciales locales.
# En local con modo off, dejar vacío; en export el valor real debe ser seguro.
APPLICATION_INSIGHTS_CONNECTION_STRING=

# Variables de otras fuentes no declaradas en este proceso no deben inventarse.
# Opcionales ausentes de secrets.json usan default de código o quedan sin resolver.
