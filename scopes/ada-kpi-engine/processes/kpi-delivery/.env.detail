# Plantilla local: copiar a .env. El despliegue remoto inyecta su configuración.
ENVIRONMENT=local

APPLICATION=ada-kpi-delivery-local

# Volumen compartido con KPI Runtime y KPI Materialization.
VOLUMEN_PATH=<absolute-shared-volume-path>

# APPLICATION del único KPI Runtime que publica el batch completo.
KPI_RUNTIME_APPLICATION=ada-kpi-runtime-local

# Intervalo genérico del runtime entre iteraciones.
# Latest Delivery mantiene 1 segundo porque el chequeo normal es local y barato.
POLL_INTERVAL_SECONDS=1

# Máximo de Tools publicadas simultáneamente hacia Cosmos.
# Default alineado con el patrón de Alarm Delivery.
KPI_DELIVERY_MAX_WORKERS=2

# Las conexiones Cosmos de salida se declaran en config/connections.json.
# Cada tool_key debe tener exactamente un Registry materializado local con el mismo nombre.

COMPANY_ABREV=<company-abrev>
PRODUCT_ABREV=<product-abrev>

ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=
APPLICATION_INSIGHTS_CONNECTION_STRING=
