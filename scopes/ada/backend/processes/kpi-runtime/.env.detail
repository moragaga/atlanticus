# Plantilla de configuración del proceso.
# Los valores entre <...> deben reemplazarse antes de ejecutar.
# En local, .env participa en la resolución. En dev/uat/stg/prd la configuración desplegada
# proviene del manifiesto/Key Vault y ENVIRONMENT debe ser inyectado por el proceso.

# Ambiente de ejecución. Valores del backend: local, dev, uat, stg, prd.
# Un archivo .env solo puede seleccionar local; los ambientes desplegados deben inyectarse al proceso.
ENVIRONMENT=local

# Identidad de la instancia local de KPI Runtime.
# El runtime la usa como segmento de almacenamiento/estado. CURRENT desplegado: ada-kpi-runtime.
APPLICATION=ada-kpi-runtime-local

# Ruta raíz usada por Atlanticus para datos, logs y estado de runtime de esta aplicación.
# Debe ser siempre absoluta.
# Local sin Docker: reemplazar por una ruta absoluta escribible del usuario que ejecuta el proceso.
# Docker/despliegue: corresponde al filesystem del contenedor; el valor CURRENT desplegado es /app/volumen.
VOLUMEN_PATH=<absolute-local-volume-path>

# Fuente Operational Data usada para PI. Valores canónicos: NOTPII o PI_WEB_API.
# CURRENT local: NOTPII.
PI_SOURCE=NOTPII

# APPLICATION del proceso que entrega la fuente PI seleccionada.
# Con PI_SOURCE=NOTPII, CURRENT local: operational-data-notpii-local.
# Con PI_SOURCE=PI_WEB_API, usar la APPLICATION correspondiente al proceso PI, normalmente operational-data-pi-local.
PI_APPLICATION=operational-data-notpii-local

# APPLICATION opcional del proceso Dispatch. Vacío deshabilita esta fuente.
DISPATCH_APPLICATION=

# APPLICATION opcional del proceso Blockgrade. Vacío deshabilita esta fuente.
BLOCKGRADE_APPLICATION=

# APPLICATION opcional del proceso Remanentes. Vacío deshabilita esta fuente.
REMANENTES_APPLICATION=

# APPLICATION opcional del proceso Fábrica. Vacío deshabilita esta fuente.
FABRICA_APPLICATION=

# Intervalo entre iteraciones de KPI Runtime, en segundos.
# Debe ser un número finito mayor que cero. Default/CURRENT: 1.
KPI_POLL_INTERVAL_SECONDS=1

# Permite reprocesar aunque el estado CURRENT ya coincida con el committed.
# Valores: true o false. false conserva el comportamiento normal. Default/CURRENT: false.
REPROCESS_CURRENT=false

# Habilita la persistencia local de eventos de observabilidad en archivos.
# Valores booleanos aceptados por runtime: 1/true/yes/on y 0/false/no/off. Default efectivo: true.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true

# Modo de observabilidad Azure. Valores: off, preview, export.
# Local CURRENT: off. En los manifests desplegados CURRENT se usa export.
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off

# Perfil de detalle enviado a Azure. Valores: slim, diagnostic.
# slim es el perfil CURRENT y el default de la extensión Azure.
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim

# Connection string de Application Insights.
# Solo se utiliza y pasa a ser obligatoria cuando ATLANTICUS_AZURE_OBSERVABILITY_MODE=export.
# Es sensible; en despliegue CURRENT se resuelve desde Key Vault.
APPLICATION_INSIGHTS_CONNECTION_STRING=
