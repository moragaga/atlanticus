# ADA Generic: despliegue local con Manager durable.
# Documentación de variables existentes y del selector nuevo; no contiene secretos.
# Copiar únicamente los valores adecuados al entorno en .env.

# Selección de Manager: auto (local en local, disabled en production), local,
# durable o disabled. Nuevo selector 1H; durable es opt-in.
ADA_MANAGER_PERSISTENCE_PROVIDER=durable

# Ambiente de Web: local o production. El CLI durable sólo admite identidad local;
# production requiere inyectar un IdentityProvider real desde el host.
ATLANTICUS_ENVIRONMENT=local

# Segmento global para Users/Navigation/Profiles/Access y segmento de herramienta.
ADA_APPLICATION_NAMESPACE=conciencia_situacional
ADA_TOOL_NAMESPACE=<tool-namespace>

# 1H durable reutiliza obligatoriamente los proveedores de Tool:
# no añade un segundo conjunto de credenciales Storage ni Cosmos.
ADA_TOOL_SOURCE_PROVIDER=blob
ADA_TOOL_PROJECTION_PROVIDER=cosmos

# Contenedor Blob ya existente para Source global, Source Tool y Users Registry.
# El CLI de recursos verifica este contenedor: todavía no lo crea.
ADA_TOOL_SOURCE_BLOB_CONTAINER_NAME=<existing-blob-container>

# Elegir SÓLO UNA opción de autenticación Blob:
# Opción A: connection string (Azurite o cuenta Azure).
ADA_TOOL_SOURCE_BLOB_CONNECTION_STRING=<connection-string>
# Opción B: SAS, dejando la connection string sin definir:
# ADA_TOOL_SOURCE_BLOB_ACCOUNT_URL=<account-url>
# ADA_TOOL_SOURCE_BLOB_SAS_TOKEN=<sas-token>

# Misma conexión Cosmos y misma base para el Tool y todo el Manager.
# El nombre del contenedor Tool lo determina el contrato de la capability.
ADA_TOOL_PROJECTION_COSMOS_ENDPOINT=<cosmos-endpoint>
ADA_TOOL_PROJECTION_COSMOS_KEY=<cosmos-key>
ADA_TOOL_PROJECTION_COSMOS_DATABASE_NAME=<cosmos-database>
ADA_TOOL_PROJECTION_COSMOS_CONTAINER_NAME=ada-tool-projection

# Contratos Cosmos automáticos derivados: navigation-projection, users-support,
# users-runtime, ada-tool-projection, ada-kpi-registry-projection y
# ada-kpi-definition-projection. No agregar variables para esos nombres.
# Si se configura COSMOS_CONSUMPTION_*, usar el mismo endpoint/base Cosmos.
# Antes de la prueba end-to-end: uv run ada-generic-manager-resources ensure-local.
# Para verificar sin modificar recursos: uv run ada-generic-manager-resources validate.
