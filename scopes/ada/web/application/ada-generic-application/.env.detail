# ADA Generic — configuración de conexiones y selección de proveedores.
# Para ejecutar sin Docker: copiar este archivo de la raíz del Starter a .env,
# sustituir todos los valores <...> y conservar sólo el mecanismo de credenciales elegido.
# Los nombres físicos de contenedores COSMOS se definen en contratos internos,
# nunca en .env; el proceso resuelve los nombres desde cada capability.
# Los valores <...> son ejemplos y se reemplazan en la configuración local.
# Las anotaciones @distribution generan los dos formatos de despliegue sin
# duplicar listas de variables. manual-default conserva valores no sensibles
# para todos los entornos; manual-local sólo conserva el ejemplo de DEV.
# Los nombres de secretos Cosmos proceden de los ejemplos proporcionados y
# deben verificarse contra cada Key Vault antes del despliegue.
# El nombre de secreto Blob está pendiente de configuración por el consumidor.
# Las opciones comentadas (SAS y KPI Delivery) no se publican como activas
# hasta sustituir explícitamente la opción correspondiente en este contrato.

# OPTIONAL. Directorio escribible para revisiones publicadas de assets.
# Ruta relativa al directorio de ejecución o ruta absoluta.
# No sensible; lo consume el host de la aplicación.
# @distribution manual
APPLICATION_PUBLICATIONS_ROOT=.runtime/publications

# Selección administrativa (modo, no tiempo de retención ni duración).
# auto: local en desarrollo, disabled en production.
# local: stores locales de desarrollo para Manager.
# durable: Manager con Source Blob y Projection Cosmos, habilitado explícitamente.
# disabled: sin Manager; ADA operacional conserva su arranque independiente.
# @distribution manual-local
ADA_MANAGER_PERSISTENCE_PROVIDER=durable

# Entorno Web (local o production). CLI durable sólo admite identidad local.
# Production requiere IdentityProvider real inyectado por el host.
# @distribution manual-local
ATLANTICUS_ENVIRONMENT=local

# Namespaces lógicos de aplicación y herramienta; no nombres de contenedores.
# @distribution manual-default
ADA_APPLICATION_NAMESPACE=conciencia_situacional

# Ruta absoluta del ZIP cifrado exclusivo de Master Projection.
# El archivo se genera fuera del Starter y se monta en el host en solo lectura.
# Dejar vacío si todavía no hay material distribuido. No es una contraseña.
# @distribution manual
ADA_MASTER_PROJECTION_MATERIAL_PATH=
# @distribution manual
ADA_TOOL_NAMESPACE=<tool-namespace>

# Proveedores Tool (independientes). El modo durable del Manager de esta etapa
# reutiliza obligatoriamente Source=blob y Projection=cosmos.
# @distribution manual-default
ADA_TOOL_SOURCE_PROVIDER=blob
# @distribution manual-default
ADA_TOOL_PROJECTION_PROVIDER=cosmos

# Blob: el único nombre físico de contenedor configurable en este arranque.
# La cadena de conexión identifica la cuenta, NO el contenedor; ambos se indican.
# El contenedor Blob debe existir antes de ejecutar ensure-local.
# @distribution manual
ADA_TOOL_SOURCE_BLOB_CONTAINER_NAME=<existing-blob-container>

# Credenciales Blob: elegir una opción, nunca ambas.
# @distribution key-vault <set-blob-connection-string-secret-name>
ADA_TOOL_SOURCE_BLOB_CONNECTION_STRING=<connection-string>
# Alternativa SAS: quitar la connection string y configurar ambos valores.
# ADA_TOOL_SOURCE_BLOB_ACCOUNT_URL=<account-url>
# ADA_TOOL_SOURCE_BLOB_SAS_TOKEN=<sas-token>

# Cosmos: conexión/base únicas para Tool y Manager; los contenedores se
# derivan de los contratos de Navigation, Users, Tool y KPI Definition/Registry.
# @distribution key-vault secret-cosmos-endpoint
ADA_TOOL_PROJECTION_COSMOS_ENDPOINT=<cosmos-endpoint>
# @distribution key-vault secret-cosmos-primary-key
ADA_TOOL_PROJECTION_COSMOS_KEY=<cosmos-key>
# @distribution key-vault secret-cosmos-sql-database-name
ADA_TOOL_PROJECTION_COSMOS_DATABASE_NAME=<cosmos-database>

# KPI Delivery, si se habilita, debe apuntar al mismo endpoint/base Cosmos.
# Los contenedores Latest/Timeseries están definidos internamente por el
# collector, no se parametrizan aquí.
# COSMOS_CONSUMPTION_ENDPOINT=<same-cosmos-endpoint>
# COSMOS_CONSUMPTION_KEY=<cosmos-key>
# COSMOS_CONSUMPTION_DATABASE_NAME=<same-cosmos-database>

# Crear/verificar la base y contenedores Cosmos en local (no crea Blob):
# uv run ada-generic-manager-resources ensure-local
# Validar recursos sin modificarlos:
# uv run ada-generic-manager-resources validate
