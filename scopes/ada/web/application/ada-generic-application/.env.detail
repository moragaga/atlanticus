# ADA Generic — contrato de configuración externa.
# Atlanticus deriva su topología interna desde ADA_PERSISTENCE_MODE.
# local: Source, Projection, Manager y Master Projection usan stores/rutas locales.
# durable: Storage compartido usa Blob; Projection y Manager usan Cosmos/Blob.
# Emulator y Azure usan el mismo contrato; el destino lo determinan los valores de conexión.
# Los nombres físicos de contenedores Cosmos se resuelven desde contratos internos.
# Todo valor <...> requiere información real del consumidor o de infraestructura.
# Las anotaciones @distribution generan DEV/UAT/PRD y el contrato de Key Vault.

# Entorno Web. El generador fija DEV=local y UAT/PRD=production.
# @distribution environment
ATLANTICUS_ENVIRONMENT=local

# Presentación de Content State. normal muestra overlays de degradación.
# authoring mantiene el estado/freshness activo pero oculta overlays para desarrollo UI.
# authoring sólo está permitido en entorno local.
ADA_CONTENT_STATE_PRESENTATION_MODE=normal

# Decisión única de persistencia distribuida. El host local puede usar durable contra
# emuladores, servicios Azure o una combinación de ambos sin cambiar este selector.
# @distribution manual-default
ADA_PERSISTENCE_MODE=durable

# Namespace lógico de la aplicación. Puede sobrescribirse por producto.
# @distribution manual-default
ADA_APPLICATION_NAMESPACE=conciencia_situacional

# Namespace lógico de la herramienta. Debe identificar la Tool concreta.
# @distribution manual
ADA_TOOL_NAMESPACE=<tool-namespace>

# Cuando ADA_PERSISTENCE_MODE=local no se requiere configuración durable adicional.
# Por defecto usa .runtime/ada y Master Projection se resuelve automáticamente en
# <local-root>/<application-namespace>/master-projection/material.zip.
# Override avanzado opcional: ADA_TOOL_LOCAL_BASE_ROOT=/absolute/path

# Container Storage físico compartido por ADA. En producción el contrato es dataproduct.
# En local puede sobrescribirse para aislar pruebas sobre un mismo Azurite.
# @distribution manual-default
ADA_STORAGE_CONTAINER_NAME=dataproduct

# Credenciales Storage: elegir connection string o SAS. El Starter distribuido publica
# connection string como contrato por defecto; SAS permanece como alternativa explícita.
# @distribution key-vault secret-ada-storage-connection-string
ADA_STORAGE_CONNECTION_STRING=<connection-string>
# ADA_STORAGE_ACCOUNT_URL=<account-url>
# ADA_STORAGE_SAS_TOKEN=<sas-token>

# Una conexión/base Cosmos compartida por las proyecciones ADA y Manager.
# El endpoint puede ser Cosmos Emulator o Azure Cosmos DB; el contrato no cambia.
# Los nombres físicos de containers se derivan internamente por capability.
# @distribution key-vault secret-cosmos-endpoint
ADA_COSMOS_ENDPOINT=<cosmos-endpoint>
# @distribution key-vault secret-cosmos-primary-key
ADA_COSMOS_KEY=<cosmos-key>
# @distribution key-vault secret-cosmos-sql-database-name
ADA_COSMOS_DATABASE_NAME=<cosmos-database>

# Master Projection no recibe una ruta manual. Su identidad lógica es fija:
# master-projection/material.zip. En durable se almacena automáticamente bajo
# <application-namespace>/master-projection/material.zip en el Storage configurado.
# Generar/provisionar material: uv run ada-generic-master-projection generate --user <service-user>

# KPI Delivery permanece independiente en este incremento. Si se habilita debe
# compartir endpoint/base Cosmos con Manager; Latest/Timeseries siguen siendo internos.
# COSMOS_CONSUMPTION_ENDPOINT=<same-cosmos-endpoint>
# COSMOS_CONSUMPTION_KEY=<cosmos-key>
# COSMOS_CONSUMPTION_DATABASE_NAME=<same-cosmos-database>

# Preparar recursos durable permitidos por el ambiente:
# uv run ada-generic-manager-resources prepare
# Validar recursos sin modificarlos:
# uv run ada-generic-manager-resources validate
