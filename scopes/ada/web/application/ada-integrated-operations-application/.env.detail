# ADA Integrated Operations — contrato de configuración Web (especialización de ADA Generic).
# Esta plantilla es para .env local, NO se suministra directamente como .env productivo.
# Para una distribución, export_integrated_operations.py genera mappings DEV/UAT/PRD
# y configuration/templates/secrets.json desde este archivo y ADA Generic .env.detail.
# En producción ATLANTICUS_ENVIRONMENT y credenciales se resuelven en el HOST distribuido.
# Todo placeholder <...> requiere decisión de infraestructura; no es una credencial real.
# NO usar las variables backend ENVIRONMENT, APPLICATION, VOLUMEN_PATH ni cron de jobs aquí.
# Web no utiliza el contrato de procesos config.detail.json / secrets.detail.json.

# 01. Entorno, puerto y rendimiento del host Web
# Ambiente Web. Valores: local | production. Default de WebSettings: local.
# El exportador de Operaciones Integradas exige que el ejemplo fuente use local.
# @distribution environment
ATLANTICUS_ENVIRONMENT=local

# Puerto Flask del comando local ada-integrated-operations-application. Default: 8000.
# No cambia el puerto del contenedor Gunicorn ni el mapeo de Docker Compose.
# ATLANTICUS_WEB_PORT=8001

# Optimización de assets CSS/JS: true/false. Default: false en local; producción fuerza true.
# ATLANTICUS_WEB_ASSETS_OPTIMIZED=true

# Umbral de solicitud lenta para observabilidad Web; milisegundos, entero > 0.
# Default real: 2000 (2 s); modificar solo si se justifica con mediciones.
# @distribution manual-default
ATLANTICUS_WEB_SLOW_REQUEST_THRESHOLD_MS=2000

# 02. Observabilidad Web
# Web sólo utiliza stdout para logs; true es inválido por contrato. Default: false.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=false

# Telemetría Azure de ADA Generic: off o export. Default: off.
# Se deja comentado para ejecución local; en export debe configurarse el host.
# La configuración export solamente admite el perfil slim actualmente.
# ATLANTICUS_AZURE_OBSERVABILITY_MODE=export
# ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim
# APPLICATION_INSIGHTS_CONNECTION_STRING=<application-insights-connection-string>
# Las credenciales se gestionan por infraestructura; nunca subirlas al repositorio.

# 03. Presentación, persistencia y namespace
# Content State: normal muestra overlays; authoring los oculta sin suprimir freshness.
# authoring sólo es válido en Web local. Default del código: normal.
ADA_CONTENT_STATE_PRESENTATION_MODE=normal

# Provider de datos: local | durable. Default real de AdaGenericSettings: local.
# Esta plantilla selecciona durable deliberadamente para usar Blob+Cosmos local o Azure.
# Si falta el selector y existen credenciales durables, el código puede inferir durable.
# @distribution manual-default
ADA_PERSISTENCE_MODE=durable

# Namespace raíz en Blob de la aplicación ADA. Default: conciencia_situacional.
# Cambiarlo requiere plan de migración de objetos y referencias.
# @distribution manual-default
ADA_APPLICATION_NAMESPACE=conciencia_situacional

# Namespace propio de la Tool Operaciones Integradas; obligatorio, sin default.
# Debe coincidir con Tool Catalog, proyecciones y consumidores. No cambiar sin migración.
# @distribution manual-default
ADA_TOOL_NAMESPACE=operaciones_integradas

# 04. Identidad y almacenamiento LOCAL (no aplica a production)
# Sujeto de usuario local opcional; omitido utiliza usuario local seleccionado.
# No es una identidad Entra ID ni habilita acceso productivo.
# ATLANTICUS_LOCAL_IDENTITY_SUBJECT_ID=local:jane-doe

# Base de persistencia local opcional cuando ADA_PERSISTENCE_MODE es local.
# Default real: .runtime/ada (se resuelve respecto del directorio de trabajo).
# ADA_TOOL_LOCAL_BASE_ROOT=.runtime/ada

# 05. Almacenamiento durable Blob
# Contenedor físico compartido de ADA. Default real: dataproduct.
# Cambiar el contenedor cambia dónde se leen/escriben artefactos durables.
# @distribution manual-default
ADA_STORAGE_CONTAINER_NAME=dataproduct

# Modalidades EXCLUYENTES de credenciales Storage:
# A) connection string, o B) URL de cuenta + SAS token (ambas variables requeridas).
# En durable debe haber exactamente una modalidad completa.
# La distribución integrada registra por defecto el connection string en Key Vault.
# @distribution key-vault secret-ada-storage-connection-string
# ADA_STORAGE_CONNECTION_STRING=<storage-connection-string>
# Alternativa SAS: requiere cambio explícito del contrato exportado/infraestructura.
# ADA_STORAGE_ACCOUNT_URL=<storage-account-url>
# ADA_STORAGE_SAS_TOKEN=<sas-token>

# 06. Cosmos durable, proyecciones y consumo
# Conexión ADA principal; obligatoria si ADA_PERSISTENCE_MODE=durable.
# Todos los nombres de contenedores Cosmos son contratos internos: no inventarlos aquí.
# @distribution key-vault secret-cosmos-endpoint
# ADA_COSMOS_ENDPOINT=<cosmos-endpoint>
# @distribution key-vault secret-cosmos-primary-key
# ADA_COSMOS_KEY=<cosmos-key>
# @distribution key-vault secret-cosmos-sql-database-name
# ADA_COSMOS_DATABASE_NAME=<cosmos-database>

# Override opcional para lecturas KPI Latest/Timeseries y alarmas; omitir para ADA_COSMOS_*.
# Si se activa, las TRES variables deben resolverse juntas (endpoint, key, database).
# En durable, el Manager actualmente exige la misma identidad endpoint+database para
# ADA_COSMOS_* y la conexión de consumo. No configurar otra base hasta resolver ese contrato.
# COSMOS_CONSUMPTION_ENDPOINT=<cosmos-consumption-endpoint>
# COSMOS_CONSUMPTION_KEY=<cosmos-consumption-key>
# COSMOS_CONSUMPTION_DATABASE_NAME=<cosmos-consumption-database>

# 07. Adopción de revisiones de Tool
# Valores admitidos: startup (default del código) | on_page_load.
# startup: fija la Tool al crear el worker; requiere reinicio para adoptar cambios.
# on_page_load: al navegar por páginas HTML verifica la revisión publicada y, si
# cambió, reconstruye el worker con su nuevo contrato. No es polling de fondo.
# Esta variable es heredada de ADA Generic y ahora también forma parte del
# contrato MODES de export_integrated_operations.py.
# El valor de referencia es startup: cambiar sólo con decisión operacional.
# @distribution manual-default
ADA_TOOL_ADOPTION_MODE=startup

# 08. Preparación / publicación
# Local durable: levantar emuladores, configurar las conexiones reales en .env local
# y ejecutar 'uv run ada-integrated-operations-resources prepare' y 'validate'.
# production: el host distribuido requiere IdentityProvider production-ready inyectado.
# No usar una identidad local en production y no copiar credenciales a la plantilla.
