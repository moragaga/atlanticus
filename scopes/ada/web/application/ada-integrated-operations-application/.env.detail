# ADA Integrated Operations — contrato externo heredado de ADA Generic.
# La aplicación especializada reutiliza el runtime, Manager, identidad, Tool Projection,
# navegación, alarm surfaces, KPI Collector y lifecycle de ADA Generic.
# Los valores de conexión determinan si durable apunta a emuladores locales o Azure.

# Entorno Web.
ATLANTICUS_ENVIRONMENT=local

# local: stores locales. durable: Blob + Cosmos mediante el contrato de ADA Generic.
ADA_PERSISTENCE_MODE=durable

# Namespace lógico de aplicación compartido por ADA.
ADA_APPLICATION_NAMESPACE=conciencia_situacional

# Namespace lógico de esta Tool.
ADA_TOOL_NAMESPACE=operaciones_integradas

# Identidad local determinística opcional para pruebas.
# ATLANTICUS_LOCAL_IDENTITY_SUBJECT_ID=local:jane-doe

# Root local opcional cuando ADA_PERSISTENCE_MODE=local.
# ADA_TOOL_LOCAL_BASE_ROOT=.runtime/ada

# Harness local de Operaciones Integradas:
# docker compose -f deployment/local/compose.yaml up -d
# uv run ada-integrated-operations-resources prepare
# uv run ada-integrated-operations-resources validate
# uv run ada-integrated-operations-application
# El host debe resolver cosmos-emulator hacia 127.0.0.1 cuando la Web corre fuera de Docker.

# Configuración durable. Requerida solamente cuando ADA_PERSISTENCE_MODE=durable.
ADA_STORAGE_CONTAINER_NAME=dataproduct
# Host + compose local: BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# ADA_STORAGE_CONNECTION_STRING=<connection-string>
# ADA_STORAGE_ACCOUNT_URL=<account-url>
# ADA_STORAGE_SAS_TOKEN=<sas-token>

# Cosmos compartido por proyecciones ADA y Manager.
# Host + compose local: http://cosmos-emulator:8081
# ADA_COSMOS_ENDPOINT=<cosmos-endpoint>
# ADA_COSMOS_KEY=<cosmos-key>
# ADA_COSMOS_DATABASE_NAME=<cosmos-database>

# KPI Delivery permanece opcional. Cuando se habilite debe compartir endpoint/base
# con el Cosmos durable de ADA.
# COSMOS_CONSUMPTION_ENDPOINT=<same-cosmos-endpoint>
# COSMOS_CONSUMPTION_KEY=<cosmos-key>
# COSMOS_CONSUMPTION_DATABASE_NAME=<same-cosmos-database>
