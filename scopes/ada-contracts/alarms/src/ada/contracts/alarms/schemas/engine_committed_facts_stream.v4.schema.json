{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ada-command-center:engine-committed-facts-stream:v4",
  "title": "EngineCommittedFactsStreamRecord v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "journal_position", "commit", "commit_record_hash", "previous_sha256", "records", "sha256"],
  "properties": {
    "schema_version": {"const": 4},
    "document_type": {"const": "ada_command_center_engine_committed_facts_stream"},
    "journal_position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "byte_offset", "commit_id"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1},
        "byte_offset": {"type": "integer", "minimum": 1},
        "commit_id": {"type": "string", "minLength": 1}
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_id", "cycle_id", "priority_group", "previous_commit_id", "evaluated_at", "committed_at", "alarm_configuration_revision", "tool_registry_revision", "runtime_artifact_version", "affected_alarms"],
      "properties": {
        "commit_id": {"type": "string", "minLength": 1},
        "cycle_id": {"type": "string", "minLength": 1},
        "priority_group": {"type": "string", "minLength": 1},
        "previous_commit_id": {"type": ["string", "null"]},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "committed_at": {"type": "string", "format": "date-time"},
        "alarm_configuration_revision": {"type": "string", "minLength": 1},
        "tool_registry_revision": {"type": "string", "minLength": 1},
        "runtime_artifact_version": {"type": "string", "minLength": 1},
        "affected_alarms": {"type": "array", "items": {"type": "string"}}
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "result_id", "manifest_sha256", "resolution_key"],
      "properties": {
        "source_key": {"type": "string", "minLength": 1},
        "result_id": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "resolution_key": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alarm_configuration_revision", "confirmed_tool_catalog_revision"],
          "properties": {
            "alarm_configuration_revision": {"type": "string", "minLength": 1},
            "confirmed_tool_catalog_revision": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "commit_record_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "previous_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "records": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assignment_changes": {"type": "array", "minItems": 1},
        "configuration_rebases": {"type": "array", "minItems": 1},
        "deactivation_effects": {"type": "array", "minItems": 1},
        "deactivation_requests": {"type": "array", "minItems": 1},
        "episode_changes": {"type": "array", "minItems": 1},
        "evidence_records": {"type": "array", "minItems": 1},
        "input_receipts": {"type": "array", "minItems": 1},
        "journey_events": {"type": "array", "minItems": 1},
        "management_effects": {"type": "array", "minItems": 1},
        "occurrence_changes": {"type": "array", "minItems": 1},
        "technical_incident_changes": {"type": "array", "minItems": 1}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
