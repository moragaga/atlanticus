# Configuración local del Alarm Modeler. Copiar a .env antes de ejecutar.
ENVIRONMENT=local
COMPANY_ABREV=<company-abrev>
PRODUCT_ABREV=<product-abrev>

# Identidad propia del Job y de su salida; diferente de la del Runtime.
APPLICATION=ada-alarm-modeler-local

# Volumen persistente compartido, ruta absoluta.
VOLUMEN_PATH=<absolute-shared-volume-path>

# APPLICATION productora de CURRENT y materialización efectiva.
ALARM_RUNTIME_APPLICATION=ada-alarm-engine-local

# Intervalo de comprobación sin imponer duración al procesamiento.
ALARM_MODELER_POLL_SECONDS=1

# Cadencia de rotación de espacios visibles cuando hay más alarmas que slots.
ALARM_MODELER_ROTATION_SECONDS=30

# Cantidad de alarmas simultáneamente visibles en la vista de atención.
ALARM_MODELER_MAX_VISIBLE_SLOTS=6

# Barrera administrativa de ejecución.
ATLANTICUS_JOB_EXECUTION_DISABLED=false

# Logging local y telemetría Azure separados.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim
APPLICATION_INSIGHTS_CONNECTION_STRING=
