# Copiar a .env únicamente en entorno local y asignar rutas y credenciales reales.
ENVIRONMENT=local
# Aplicación dueña del estado de confirmaciones. Debe diferir del Modeler.
APPLICATION=ada-alarm-delivery-local
# Volumen persistente compartido entre Modeler y Delivery, ruta absoluta.
VOLUMEN_PATH=/app/volumen
# Identidad de la APPLICATION que publica current/latest.json del Modeler.
ALARM_MODELER_APPLICATION=ada-alarm-modeler-local
# Segundos entre comprobaciones; no fuerza escrituras si no hay novedades.
ALARM_DELIVERY_POLL_SECONDS=5
# Concurrencia máxima de Tools; cada operación abre su propio cliente Cosmos.
ALARM_DELIVERY_MAX_WORKERS=4
# OFF (normal): no consulta ni crea contenedores Cosmos.
# ENSURE (preparación puntual): una pasada antes del job, crea solo los contenedores faltantes
# y valida partición y TTL de los existentes. Requiere bases Cosmos ya creadas.
# Tras la primera preparación satisfactoria, volver a OFF para evitar el costo de comprobación.
ADA_COSMOS_PROVISION_MODE=OFF
# Variables declaradas por config/connections.json para cada Tool.
ALARM_TOOL_EXAMPLE_COSMOS_ENDPOINT=https://tool-example.documents.azure.com:443/
ALARM_TOOL_EXAMPLE_COSMOS_DATABASE_NAME=tool-example-db
# Solo local: colocar el secreto real en .env, nunca versionarlo.
ALARM_TOOL_EXAMPLE_COSMOS_KEY=<local-secret>
# Control de ejecución y observabilidad separados.
ATLANTICUS_JOB_EXECUTION_DISABLED=false
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off
# Perfil de telemetría, cuando se utiliza Azure: slim o diagnostic.
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim

# Requerido solo con telemetría en modo export.
APPLICATION_INSIGHTS_CONNECTION_STRING=
