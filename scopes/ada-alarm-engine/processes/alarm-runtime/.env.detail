# Plantilla de configuración local del proceso.
# Copiar este archivo a .env antes de ejecutar localmente.
# Los valores entre <...> deben reemplazarse antes de ejecutar.

# Ambiente de ejecución. Valores admitidos: local, dev, uat, stg, prd.
ENVIRONMENT=local

# Identidad corporativa usada sólo para resolver Key Vault en ambientes desplegados.
COMPANY_ABREV=<company-abrev>
PRODUCT_ABREV=<product-abrev>

# Identidad compartida de la instancia Alarm Engine (Runtime y Materialization).
# Cada job conserva su propia identidad job_key, lease y fencing.
APPLICATION=ada-alarm-engine-local

# Volumen compartido. El estado propio del motor se ubica en
# VOLUMEN_PATH/APPLICATION/alarms; productores externos usan sus APPLICATION.
# Las publicaciones CURRENT y FACTS se escriben en
# VOLUMEN_PATH/APPLICATION/alarms/output, sin cambios en el WAL ni sus snapshots.
# CURRENT operacional: current/latest.json; CURRENT durable: current/durable-latest.json.
VOLUMEN_PATH=<absolute-shared-volume-path>

# Barrera administrativa común de Atlanticus Runtime.
# false permite ejecutar. true impide iniciar nuevas ejecuciones del job.
ATLANTICUS_JOB_EXECUTION_DISABLED=false

# Fuente física para las vistas PI del contrato Operational Data.
# Valores canónicos: NOTPII o PI_WEB_API.
PI_SOURCE=NOTPII

# APPLICATION del productor PI seleccionado.
PI_APPLICATION=operational-data-notpii-local

# Rutas opcionales. Pueden permanecer vacías mientras ninguna alarma adoptada
# solicite un DataSource de ese productor.
DISPATCH_APPLICATION=
BLOCKGRADE_APPLICATION=
REMANENTES_APPLICATION=
FABRICA_PLANES_APPLICATION=
FABRICA_KPIS_APPLICATION=
METEODATA_APPLICATION=

# Poll operacional en segundos. No fuerza publicaciones ni es un SLA de ejecución.
# Temporizadores y rotaciones se resuelven aunque no cambie la evidencia física.
ALARM_RUNTIME_POLL_SECONDS=1

# Logs locales separados de la telemetría Azure.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true

# Modo Azure: off, preview o export.
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off

# Perfil Azure: slim o diagnostic.
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim

# Requerido sólo cuando el modo Azure efectivo es export.
APPLICATION_INSIGHTS_CONNECTION_STRING=
