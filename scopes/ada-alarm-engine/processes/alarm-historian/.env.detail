# Plantilla local. Copiar a .env antes de ejecutar.
# Los marcadores <...> son valores pendientes de completar y no son ejecutables.

# Entorno: local, dev, uat, stg, prd.
ENVIRONMENT=local

# Identidad para Key Vault en ambientes desplegados, solo si hay secretos allí.
COMPANY_ABREV=<company-abrev>
PRODUCT_ABREV=<product-abrev>

# Propietario del checkpoint y de los Parquet, independiente del productor.
# Los datos históricos se guardan bajo VOLUMEN_PATH/APPLICATION/alarms.
APPLICATION=ada-alarm-historian-local

# Volumen durable compartido entre el productor FACTS y este proceso.
# Debe ser absoluto; no configurar un directorio efímero del contenedor.
VOLUMEN_PATH=<absolute-shared-volume-path>

# Identidad estable de la fuente FACTS v4. No cambiarla al reiniciar o redeplegar.
# Cambiarla requiere una migración controlada; el checkpoint rechaza cambios.
ALARM_HISTORIAN_STREAM_ID=<stable-facts-stream-id>

# APPLICATION exacta del proceso Alarm Runtime que escribió FACTS.
# Se lee VOLUMEN_PATH/<producer-application>/alarms/output.
ALARM_HISTORIAN_PRODUCER_APPLICATION=<alarm-runtime-application>

# Máximo de registros FACTS por invocación (1 a 10000).
# La ejecución procesa un lote y termina; el planificador decide la siguiente invocación.
ALARM_HISTORIAN_MAX_RECORDS=100

# Barrera administrativa: true deshabilita la ejecución del Job.
ATLANTICUS_JOB_EXECUTION_DISABLED=false

# Logs de volumen separados de telemetría Azure.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true

# Telemetría Azure: off, preview, export.
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off

# Perfil de telemetría, cuando se utiliza Azure: slim o diagnostic.
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim

# Requerido solo con telemetría en modo export.
APPLICATION_INSIGHTS_CONNECTION_STRING=
