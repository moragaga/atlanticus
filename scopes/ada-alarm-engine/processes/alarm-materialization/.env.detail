# Plantilla de configuración local del proceso.
# Copiar este archivo a .env antes de ejecutar localmente.
# Los valores entre <...> deben reemplazarse antes de ejecutar.
# En local, .env participa en la resolución de configuración.
# En dev/uat/stg/prd, la plataforma entrega configuración y secretos.

# Ambiente de ejecución. Valores admitidos: local, dev, uat, stg, prd.
ENVIRONMENT=local

# Identidad corporativa usada sólo para resolver Key Vault en ambientes desplegados.
COMPANY_ABREV=<company-abrev>
PRODUCT_ABREV=<product-abrev>

# Identidad propia del proceso. No corresponde a Command Center aunque lea uno de sus recursos.
# CURRENT objetivo desplegado: ada-alarm-materialization.
APPLICATION=ada-alarm-materialization-local

# Volumen durable compartido donde Materialization publica manifest.json, engine.json,
# modeler.json y delivery.json. Debe ser una ruta absoluta.
VOLUMEN_PATH=<absolute-shared-volume-path>

# Barrera administrativa común de Atlanticus Runtime.
# false permite ejecutar normalmente. true impide iniciar nuevas ejecuciones del job;
# la imagen oficial también puede terminar con exit 0 antes de iniciar Python.
ATLANTICUS_JOB_EXECUTION_DISABLED=false

# Conexión read-only al Cosmos cuyo recurso Alarm Configuration pertenece a Command Center.
# Materialization NO crea database/container, no repara topología y no publica en este Cosmos.
COMMAND_CENTER_COSMOS_ENDPOINT=http://localhost:8081
COMMAND_CENTER_COSMOS_DATABASE_NAME=<command-center-cosmos-database>
COMMAND_CENTER_COSMOS_KEY=<local-command-center-cosmos-key>

# Container aprovisionado por Command Center que contiene la proyección activa.
# CURRENT físico verificado: alarm-configuration.
ALARM_CONFIGURATION_CONTAINER_NAME=alarm-configuration

# Evidencia controlada de qualification para la release candidata.
# Debe ser una ruta absoluta. Ver qualification.detail.json para el contrato esperado.
ALARM_QUALIFICATIONS_FILE=<absolute-alarm-qualification-file>

# Intervalo normal entre iteraciones, en segundos. Debe ser mayor que cero.
# Si la proyección aún no existe, PENDING fuerza un retry de readiness a 30 segundos.
ALARM_MATERIALIZATION_POLL_SECONDS=30

# Logs locales separados de la telemetría Azure.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true

# Modo Azure: off, preview o export.
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off

# Perfil Azure: slim o diagnostic.
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim

# Requerido sólo cuando el modo Azure efectivo es export.
APPLICATION_INSIGHTS_CONNECTION_STRING=
