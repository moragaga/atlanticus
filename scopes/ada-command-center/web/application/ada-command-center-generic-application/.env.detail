# ADA Command Center Generic Application — contrato Web de ejecución local.
# Host Command Center + Manager Principal, no job backend. NO usa ENVIRONMENT,
# APPLICATION ni VOLUMEN_PATH de Atlanticus Runtime de procesos.
# En producción las credenciales y ATLANTICUS_ENVIRONMENT deben ser inyectados por el host;
# el entrypoint CURRENT de Command Center utiliza identidad local y RECHAZA production.
# Los placeholders <...> NO son valores aptos para producción.
# El contrato de distribución de Web se documenta en @distribution: no se debe
# crear secrets.detail.json/config.detail.json de job porque no se consumen aquí.

# 01. Ambiente y observabilidad Web
# Valores: local | production. Default de WebSettings: local.
# En producción sólo host autenticado (no soportado por el entrypoint local actual).
# @distribution environment
ATLANTICUS_ENVIRONMENT=local

# Logs Web sólo stdout; true es rechazado por WebSettings. Default: false.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=false

# WEB-OBS-02: umbral de solicitud lenta en ms. Default WebSettings 2000; entero > 0.
# Su ajuste es excepcional y debe basarse en latencia observada.
# ATLANTICUS_WEB_SLOW_REQUEST_THRESHOLD_MS=2000

# ATLANTICUS_WEB_ASSETS_OPTIMIZED: default false en local; production fuerza true.
# ATLANTICUS_WEB_ASSETS_OPTIMIZED=true

# ATLANTICUS_WEB_PORT se acepta en WebSettings (default 8000), pero el __main__
# actual llama run_web_application() sin pasar el puerto; no usar esta variable para
# cambiar el bind del Command Center Generic hasta actualizar ese entrypoint.
# APPLICATION_INSIGHTS_CONNECTION_STRING es conocido por WebSettings, pero este
# entrypoint NO compone un exporter Azure específico como ADA Generic: no asumir
# exportación de telemetría productiva sin calificación adicional.

# 02. Proveedor de persistencia e identidad local
# local | durable. Default del Reader: local; se elige durable para prueba integrada.
# En production el proveedor debe ser durable (además del host autenticado).
# @distribution manual-default
ADA_MANAGER_PERSISTENCE_PROVIDER=durable

# Identidad local opcional. Si se omite usa el primer usuario de LOCAL_USERS.
# No representa una identidad productiva. Verificar que el sujeto exista en LOCAL_USERS.
# ATLANTICUS_LOCAL_IDENTITY_SUBJECT_ID=local:jane-doe

# 03. Espacio lógico de almacenamiento
# Namespace compartido con ADA; obligatorio en Command Center (sin default del Reader).
# Cambios de namespace requieren migración explícita de Blob, Cosmos y referencias.
# @distribution manual-default
ADA_APPLICATION_NAMESPACE=conciencia_situacional

# Namespace administrativo de Command Center, no usar el de una Tool externa.
# Obligatorio; se utiliza en rutas Source, Tool Catalog, Users y memberships.
# @distribution manual
ADA_TOOL_NAMESPACE=command-center

# 04. Storage Command Center
# Contenedor físico de Blob; requerido incluso con el provider local actual
# para leer Tool Catalog en la composición local. Valor documental existente dataproduct.
# No es un default implícito del ManagerConfigurationReader.
# @distribution manual-default
ADA_COMMAND_CENTER_STORAGE_CONTAINER_NAME=dataproduct

# Elegir exactamente una modalidad: connection string o URL de cuenta + SAS token.
# Los modos son mutuamente excluyentes incluso en ambiente local.
# La conexión puede apuntar a Azurite o Azure según el HOST configurado.
# @distribution key-vault secret-ada-command-center-storage-connection-string
ADA_COMMAND_CENTER_STORAGE_CONNECTION_STRING=<storage-connection-string>
# Alternativa SAS (ambas variables requeridas, no mezclar con connection string):
# ADA_COMMAND_CENTER_STORAGE_ACCOUNT_URL=<storage-account-url>
# ADA_COMMAND_CENTER_STORAGE_SAS_TOKEN=<sas-token>

# 05. Cosmos administrativo de Command Center
# En durable: los tres valores son obligatorios, sin defaults del Reader.
# Base propia de Command Center: Alarm Configuration, Profiles, Navigation y Users.
# No reutilizar la base Cosmos de las Tools externas para Command Center.
# @distribution key-vault secret-ada-command-center-cosmos-endpoint
ADA_COMMAND_CENTER_COSMOS_ENDPOINT=<command-center-endpoint>
# @distribution key-vault secret-ada-command-center-cosmos-database-name
ADA_COMMAND_CENTER_COSMOS_DATABASE_NAME=<command-center-database>
# @distribution key-vault secret-ada-command-center-cosmos-primary-key
ADA_COMMAND_CENTER_COSMOS_KEY=<command-center-key>

# 06. Cosmos externo por Tool (opcional; conexión completa por Tool)
# Patrón de nombres reconocido: ADA_COMMAND_CENTER_TOOL_COSMOS_<TOOL>_ENDPOINT,
# ADA_COMMAND_CENTER_TOOL_COSMOS_<TOOL>_DATABASE_NAME,
# ADA_COMMAND_CENTER_TOOL_COSMOS_<TOOL>_KEY. Reemplazar <TOOL> por nombre válido.
# No apuntar endpoint+database de una Tool a la misma DB propia de Command Center:
# el Reader lo rechaza. Se deben configurar las tres variables por cada Tool habilitada.
# Ejemplo de nombres para Tool MINA (sin valores reales):
# ADA_COMMAND_CENTER_TOOL_COSMOS_MINA_ENDPOINT=<tool-cosmos-endpoint>
# ADA_COMMAND_CENTER_TOOL_COSMOS_MINA_DATABASE_NAME=<tool-cosmos-database>
# ADA_COMMAND_CENTER_TOOL_COSMOS_MINA_KEY=<tool-cosmos-key>

# 07. Publicaciones y recursos
# APPLICATION_PUBLICATIONS_ROOT: override opcional de root de publicaciones Web.
# El default documentado para esta aplicación es <package>/.runtime/publications.
# No declarar una ruta arbitraria hasta confirmar el consumidor y mount productivo.
# APPLICATION_PUBLICATIONS_ROOT=/absolute/path/to/publications

# Admin resources: 'uv run ada-command-center-manager-resources validate' es read-only;
# 'prepare' puede crear/asegurar recursos según el entorno. Requiere conexiones reales.
# El host prod y Entra ID siguen BLOCKED: el __main__ actual usa LocalIdentityProvider.
