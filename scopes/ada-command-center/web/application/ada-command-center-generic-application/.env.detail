# ADA Command Center Generic Application — contrato de configuración externa.
# ATLANTICUS_ENVIRONMENT define el host; ADA_MANAGER_PERSISTENCE_PROVIDER define persistencia.
# Emulator y Azure usan el mismo contrato; el destino lo determinan los valores de conexión.
# No incluir credenciales reales en este archivo.
# Las anotaciones @distribution generan DEV/UAT/PRD y el contrato de Key Vault.

# El runtime CURRENT integrado usa Identity -> Users Runtime -> Manager Principal.
# La composición de identidad production permanece fuera de este incremento.
# @distribution environment
ATLANTICUS_ENVIRONMENT=local

# local: Alarm Configuration y administración usan filesystem/in-process donde corresponda.
# durable: Source/Users Registry/Tool Membership usan Blob y Projection/Users Runtime usan Cosmos.
# El host local soporta ambos providers. Para despliegue se usa durable.
# @distribution manual-default
ADA_MANAGER_PERSISTENCE_PROVIDER=durable

# Identidad local opcional. Si se omite, usa el primer usuario local definido por Atlanticus.
# Para conservar acceso administrativo local, usar una identidad de LOCAL_USERS.
# ATLANTICUS_LOCAL_IDENTITY_SUBJECT_ID=local:jane-doe

# Namespace compartido con ADA Generic. Requerido; no hay valores implícitos.
# @distribution manual-default
ADA_APPLICATION_NAMESPACE=conciencia_situacional
# Scope administrativo de Command Center, nunca el de una Tool externa.
# @distribution manual
ADA_TOOL_NAMESPACE=command-center
# Cambiar estos valores cambia la ubicación Blob; requiere migración explícita.

# Container Storage físico compartido por Command Center. En producción el contrato es
# dataproduct. En local puede sobrescribirse para aislar pruebas sobre un mismo Azurite.
# @distribution manual-default
ADA_COMMAND_CENTER_STORAGE_CONTAINER_NAME=dataproduct

# Una sola conexión Storage para Tool Catalog, Sources, Users Registry, Tool Membership y Master Projection.
# Puede apuntar a Azure Storage o a un emulador compatible sin cambiar el contrato.
# @distribution key-vault secret-ada-command-center-storage-connection-string
ADA_COMMAND_CENTER_STORAGE_CONNECTION_STRING=<storage-connection-string>
# Alternativa a connection string: indicar ambas variables SAS, no mezclar modos.
# ADA_COMMAND_CENTER_STORAGE_ACCOUNT_URL=<storage-account-url>
# ADA_COMMAND_CENTER_STORAGE_SAS_TOKEN=<storage-sas-token>

# Base Cosmos propia de Command Center para Alarm Configuration, Profiles, Navigation y Users Runtime.
# Puede apuntar a Cosmos Emulator o Azure Cosmos DB sin cambiar el contrato.
# No reutilizar la base de proyecciones de ADA: los containers genéricos de administración
# tienen identidades físicas propias dentro de esta base de Command Center.
# @distribution key-vault secret-ada-command-center-cosmos-endpoint
ADA_COMMAND_CENTER_COSMOS_ENDPOINT=<command-center-endpoint>
# @distribution key-vault secret-ada-command-center-cosmos-database-name
ADA_COMMAND_CENTER_COSMOS_DATABASE_NAME=<command-center-database>
# @distribution key-vault secret-ada-command-center-cosmos-primary-key
ADA_COMMAND_CENTER_COSMOS_KEY=<command-center-key>

# Conexiones externas por herramienta para Tool Catalog discovery/consolidation.
# ADA_COMMAND_CENTER_TOOL_COSMOS_MINA_ENDPOINT=<tool-endpoint>
# ADA_COMMAND_CENTER_TOOL_COSMOS_MINA_DATABASE_NAME=<tool-database>
# ADA_COMMAND_CENTER_TOOL_COSMOS_MINA_KEY=<tool-key-secret>

# Publicaciones Web. Si se omite, usa <package>/.runtime/publications.
# APPLICATION_PUBLICATIONS_ROOT=/absolute/path/to/publications

# Rutas derivadas de ADA_APPLICATION_NAMESPACE y ADA_TOOL_NAMESPACE:
# namespace = conciencia_situacional/command-center
# Tool Catalog = conciencia_situacional/command-center/tool-catalog/current.json
# Sources = conciencia_situacional/command-center/sources/<source-key>/...
# Users Registry = conciencia_situacional/users/users.json.gz
# Tool Membership = conciencia_situacional/command-center/users/memberships.json.gz
# Users Recovery Snapshots = conciencia_situacional/command-center/users/recovery/snapshots/...
# Cosmos Alarm Configuration = alarm-configuration, PK /partition_key
# Cosmos Profiles = profiles-projection, PK /partition_key
# Cosmos Navigation = navigation-projection, PK /partition_key
# Cosmos Users Runtime = users-runtime, PK /id
# La primera ejecución puede estar vacía; no se crean ejemplos automáticamente.

# Preparación durable explícita compartida con ADA a través de Atlanticus.
# local/prepare puede crear el container Blob, la base Cosmos y los containers contractuales.
# production/prepare omite Blob, valida la base y asegura los containers contractuales.
# validate es siempre read-only.
# uv run ada-command-center-manager-resources prepare
# uv run ada-command-center-manager-resources validate

# Master Projection no agrega variables manuales.
# Identidad lógica del material = conciencia_situacional/command-center.
# local = <runtime-root>/conciencia_situacional/command-center/master-projection/material.zip
# durable = conciencia_situacional/command-center/master-projection/material.zip en Storage.
# Users se aplica mediante el contrato especial de snapshot/recovery, no como ProjectionDomain ordinario.
# Generar/provisionar material:
# uv run ada-command-center-master-projection generate --user <service-user>
