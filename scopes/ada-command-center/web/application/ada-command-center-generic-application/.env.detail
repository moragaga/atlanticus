# ADA Command Center Generic Application — contrato de configuración externa.
# ATLANTICUS_ENVIRONMENT define el host; ADA_MANAGER_PERSISTENCE_PROVIDER define persistencia.
# Emulator y Azure usan el mismo contrato; el destino lo determinan los valores de conexión.
# No incluir credenciales reales en este archivo.

# El host integrado CURRENT usa identidad local y no admite production todavía.
ATLANTICUS_ENVIRONMENT=local

# local: Alarm Configuration y administración usan filesystem/in-process donde corresponda.
# durable: Source usa Blob y Projection/Users usan Cosmos; Tool Catalog usa Storage.
# El host local soporta ambos providers. Para el checkpoint de despliegue se usa durable.
ADA_MANAGER_PERSISTENCE_PROVIDER=durable

# Identidad local opcional. Si se omite, Atlanticus usa local:<usuario-del-sistema>.
# Override avanzado para pruebas locales:
# ATLANTICUS_LOCAL_IDENTITY_SUBJECT_ID=local:<usuario-del-sistema>

# Una sola conexión y contenedor Storage para Tool Catalog, Sources y Users Registry durable.
# Puede apuntar a Azure Storage o a un emulador compatible sin cambiar el contrato.
ADA_COMMAND_CENTER_STORAGE_CONNECTION_STRING=<storage-connection-string>
ADA_COMMAND_CENTER_STORAGE_CONTAINER_NAME=<storage-container>

# Base Cosmos propia de Command Center para Alarm Configuration, Profiles, Navigation y Users.
# Puede apuntar a Cosmos Emulator o Azure Cosmos DB sin cambiar el contrato.
# No reutilizar la base de proyecciones de ADA: los containers genéricos de administración
# tienen identidades físicas propias dentro de esta base de Command Center.
ADA_COMMAND_CENTER_COSMOS_ENDPOINT=<command-center-endpoint>
ADA_COMMAND_CENTER_COSMOS_DATABASE_NAME=<command-center-database>
ADA_COMMAND_CENTER_COSMOS_KEY=<command-center-key>

# Conexiones externas por herramienta para Tool Catalog discovery/consolidation.
# ADA_COMMAND_CENTER_TOOL_COSMOS_MINA_ENDPOINT=<tool-endpoint>
# ADA_COMMAND_CENTER_TOOL_COSMOS_MINA_DATABASE_NAME=<tool-database>
# ADA_COMMAND_CENTER_TOOL_COSMOS_MINA_KEY=<tool-key-secret>

# Publicaciones Web. Si se omite, usa <package>/.runtime/publications.
# APPLICATION_PUBLICATIONS_ROOT=/absolute/path/to/publications

# Rutas/recursos derivados; no son variables configurables:
# namespace = conciencia_situacional/command-center
# Tool Catalog = conciencia_situacional/command-center/tool-catalog/current.json
# Sources = conciencia_situacional/command-center/sources/<source-key>/...
# Users Registry = conciencia_situacional/command-center/users/users.json.gz
# Cosmos Alarm Configuration = alarm-configuration, PK /partition_key
# Cosmos Profiles = profiles-projection, PK /partition_key
# Cosmos Navigation = navigation-projection, PK /partition_key
# Cosmos Users = users-runtime, PK /id
# La primera ejecución puede estar vacía; no se crean ejemplos automáticamente.

# Master Projection no agrega variables manuales.
# Identidad lógica del material = conciencia_situacional/command-center.
# local = <runtime-root>/conciencia_situacional/command-center/master-projection/material.zip
# durable = conciencia_situacional/command-center/master-projection/material.zip en Storage.
# Generar/provisionar material:
# uv run ada-command-center-master-projection generate --user <service-user>
