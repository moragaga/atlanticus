# Web Command Center: contrato documental. No incluir credenciales reales.
# Autoridad Web única: ATLANTICUS_ENVIRONMENT = local | production.
# ENVIRONMENT (dev/uat/stg/prd) pertenece al bootstrap de procesos backend y NO se utiliza aquí.
ATLANTICUS_ENVIRONMENT=local
# Reutiliza ADA_MANAGER_PERSISTENCE_PROVIDER del Manager existente.
# Command Center selecciona solamente local | durable; auto/disabled no son usados por este host.
# No introduce un modo sample ni durable-local; el ambiente Web se define aparte.
# local: Alarm Source y Projection persistidos en filesystem; Tool Catalog en Storage.
# durable: Alarm Source en Blob y Projection en Cosmos; Tool Catalog en el mismo Storage.
# El host de producción autenticado debe elegir durable; __main__ solo arranca localmente.
ADA_MANAGER_PERSISTENCE_PROVIDER=local

# Una sola conexión y contenedor de Storage para Tool Catalog en ambos modos.
# En durable también se usan para Alarm Configuration Source.
# En local se puede utilizar Azurite para Storage; no se crean herramientas de ejemplo.
# El host inyecta los valores en producción mediante el despliegue y su mapeo de secretos.
ADA_COMMAND_CENTER_STORAGE_CONNECTION_STRING=<storage-connection-string>
ADA_COMMAND_CENTER_STORAGE_CONTAINER_NAME=<storage-container>

# Solo para el proveedor durable: Cosmos propio de Command Center.
# El contenedor y la partición se derivan del contrato existente.
ADA_COMMAND_CENTER_COSMOS_ENDPOINT=<command-center-endpoint>
ADA_COMMAND_CENTER_COSMOS_DATABASE_NAME=<command-center-database>
ADA_COMMAND_CENTER_COSMOS_KEY=<command-center-key>

# Conexiones externas, una por herramienta. Agrupación automática por prefijo:
# ADA_COMMAND_CENTER_TOOL_COSMOS_MINA_ENDPOINT=<tool-endpoint>
# ADA_COMMAND_CENTER_TOOL_COSMOS_MINA_DATABASE_NAME=<tool-database>
# ADA_COMMAND_CENTER_TOOL_COSMOS_MINA_KEY=<tool-key-secret>

# Rutas físicas derivadas (NO son variables configurables):
# namespace = conciencia_situacional/command-center
# Tool Catalog = conciencia_situacional/command-center/tool-catalog/current.json
# Alarm Source = conciencia_situacional/command-center/sources/alarm-configuration/...
# Alarm Projection local = conciencia_situacional/command-center/projections/alarm-configuration/...
# Alarm Cosmos = alarm-configuration, PK /partition_key.
# En producción, resolver las referencias de las plantillas mapping/secrets antes de iniciar Web.
# En local, el filesystem deriva desde <cwd>/.runtime mediante AdaStorageNamespace:
# <cwd>/.runtime/conciencia_situacional/command-center/...
# La primera ejecución puede estar vacía. Publicar Tool Catalog mediante el Manager;
# después configurar y publicar alarmas manualmente, sin bootstrap de ejemplos.
