# ADA Command Center Configuration Manager — host de qualification LOCAL.
# NO es el runtime productivo. Reutiliza ManagerConfigurationReader y sus
# contratos de namespace, conexión y recursos con Command Center Generic.
# No mezclar variables backend ENVIRONMENT, APPLICATION, VOLUMEN_PATH ni cron aquí.
# No introducir secrets.detail.json/config.detail.json de proceso: bootstrap Web
# resuelve .env local / variables inyectadas por host en production.
# Valores <...>: placeholders de despliegue pendientes, nunca secretos reales.
# El __main__ de este host rechaza production explícitamente.

# 01. Entorno y observabilidad
# Valores: local | production; este host debe ejecutarse local.
# Default de WebSettings: local; no probar production mediante una línea .env.
ATLANTICUS_ENVIRONMENT=local

# Logs Web únicamente stdout. Default WebSettings false; true es inválido.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=false

# Umbral de solicitud lenta en ms; default real de WebSettings: 2000 (>0).
# ATLANTICUS_WEB_SLOW_REQUEST_THRESHOLD_MS=2000
# Optimización assets local opcional, default false; production fuerza true.
# ATLANTICUS_WEB_ASSETS_OPTIMIZED=true

# ATLANTICUS_WEB_PORT (default WebSettings 8000) no controla el __main__ de este
# host, que usa run_web_application() sin pasar port; bind fijo por default.
# APPLICATION_INSIGHTS_CONNECTION_STRING es campo WebSettings; este __main__
# no inyecta un exporter Azure específico. No afirmar telemetría Azure productiva.

# 02. Persistencia y namespace
# Proveedor: local | durable; default interno local, plantilla durable para qualification.
# production exige durable, pero el __main__ no permite production.
ADA_MANAGER_PERSISTENCE_PROVIDER=durable

# Namespace lógico de aplicación, requerido y sin default del Reader.
# @distribution manual-default
ADA_APPLICATION_NAMESPACE=conciencia_situacional

# Namespace administrativo exclusivo de Command Center; requerido sin default.
# @distribution manual
ADA_TOOL_NAMESPACE=command-center

# El namespace modifica las rutas de objetos; cambiarlo exige migración explícita.

# 03. Blob Storage
# El Reader exige contenedor aun cuando usa Tool Catalog desde el provider local.
# Valor de referencia del otro host: dataproduct; NO es default del Reader.
ADA_COMMAND_CENTER_STORAGE_CONTAINER_NAME=dataproduct

# Elegir connection string O URL+SAS (ambas variables), nunca mezclar las dos vías.
# La URL/credenciales pueden apuntar a Azurite o Azure según el host.
ADA_COMMAND_CENTER_STORAGE_CONNECTION_STRING=<storage-connection-string>
# ADA_COMMAND_CENTER_STORAGE_ACCOUNT_URL=<storage-account-url>
# ADA_COMMAND_CENTER_STORAGE_SAS_TOKEN=<storage-sas-token>

# 04. Cosmos Command Center — obligatorio para durable
# Endpoint, base y key reales, sin defaults.
ADA_COMMAND_CENTER_COSMOS_ENDPOINT=<command-center-endpoint>
ADA_COMMAND_CENTER_COSMOS_DATABASE_NAME=<command-center-database>
ADA_COMMAND_CENTER_COSMOS_KEY=<command-center-key>

# 05. Conexiones Cosmos externas por Tool (opcionales)
# Cada Tool requiere trio completo de *_ENDPOINT, *_DATABASE_NAME y *_KEY.
# Los endpoints de Tools no pueden apuntar a la misma identidad endpoint+database
# propia de Command Center. Ejemplo de nombres para MINA:
# ADA_COMMAND_CENTER_TOOL_COSMOS_MINA_ENDPOINT=<tool-endpoint>
# ADA_COMMAND_CENTER_TOOL_COSMOS_MINA_DATABASE_NAME=<tool-database>
# ADA_COMMAND_CENTER_TOOL_COSMOS_MINA_KEY=<tool-key>

# 06. Validación
# 'uv run ada-command-center-manager-resources prepare' prepara recursos durables;
# 'uv run ada-command-center-manager-resources validate' sólo los verifica.
# Nunca almacenar credenciales reales en archivos versionados ni despliegue sin Entra ID.
