# B1d - contrato de configuración para cualificación manual; no es un .env independiente.
# Añadir los valores a .env del host Web ada-command-center-configuration-manager o al entorno del proceso.
# No guardar secretos reales en repositorios ni en este archivo.
# La autoridad de ambiente Web es ATLANTICUS_ENVIRONMENT; nunca ENVIRONMENT backend.
ATLANTICUS_ENVIRONMENT=local

# Primero local para catálogo; cambiar a durable para publicar/verificar Alarm Source y Cosmos.
ADA_MANAGER_PERSISTENCE_PROVIDER=durable

# Única conexión y contenedor compartido por Tool Sources de esta cualificación y Command Center.
# Contenedor preexistente; puede estar alojado en Azurite.
ADA_COMMAND_CENTER_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
ADA_COMMAND_CENTER_STORAGE_CONTAINER_NAME=ada-web-source-local

# Las herramientas de cualificación se conectan a bases separadas del emulador Cosmos.
# Los nombres PROCESS e INTEGRATED definen las conexiones externas descubiertas por B1c.
ADA_COMMAND_CENTER_TOOL_COSMOS_PROCESS_ENDPOINT=http://127.0.0.1:8081
ADA_COMMAND_CENTER_TOOL_COSMOS_PROCESS_DATABASE_NAME=ada-local-process
ADA_COMMAND_CENTER_TOOL_COSMOS_PROCESS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
ADA_COMMAND_CENTER_TOOL_COSMOS_INTEGRATED_ENDPOINT=http://127.0.0.1:8081
ADA_COMMAND_CENTER_TOOL_COSMOS_INTEGRATED_DATABASE_NAME=ada-local-io
ADA_COMMAND_CENTER_TOOL_COSMOS_INTEGRATED_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==

# Requeridos únicamente en durable; no confundir con las bases Cosmos de las dos herramientas.
ADA_COMMAND_CENTER_COSMOS_ENDPOINT=http://127.0.0.1:8081
ADA_COMMAND_CENTER_COSMOS_DATABASE_NAME=ada-local-acc
ADA_COMMAND_CENTER_COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==

# Rutas DERIVADAS, NO variables configurables:
# Process Source: conciencia_situacional/validation_process/sources/tools/...
# Integrated Source: conciencia_situacional/validation_integrated/sources/tools/...
# Cosmos Tool: nombre físico del contrato TOOL_PROJECTION_STORAGE_RESOURCE; PK /partition_key.
# Catalog CURRENT: conciencia_situacional/command-center/tool-catalog/current.json.
# Alarm Source durable: conciencia_situacional/command-center/sources/alarm-configuration/...
# Alarm Projection Cosmos: contrato ALARM_CONFIGURATION_PROJECTION_STORAGE_RESOURCE; PK /partition_key.
# Requerir validación/creación EXPLÍCITA de Cosmos con 'prepare [--apply]'.
# Crear previamente el contenedor Blob con la herramienta administrativa actual; el script no lo aprovisiona.
# Cada comando de escritura (publish-tool, project-tool, prepare --apply) requiere ejecución humana.
