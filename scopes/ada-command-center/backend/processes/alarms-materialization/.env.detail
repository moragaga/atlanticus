# Plantilla local: copiar a .env y completar únicamente los parámetros del entorno.
# En los demás ambientes, el despliegue entrega las variables y secretos necesarios.
ENVIRONMENT=local

# Identidad corporativa requerida únicamente al resolver secretos de Key Vault.
COMPANY_ABREV=<company-abrev>
PRODUCT_ABREV=<product-abrev>

# APPLICATION es compartida por los tres procesos; cada job conserva lease propio por job_key.
APPLICATION=ada-command-center

# Ruta absoluta de volumen, elegida manualmente por el operador y montada de forma
# equivalente en los tres procesos. No se deduce ni se impone desde APPLICATION.
VOLUMEN_PATH=<absolute-shared-volume-path>

# Conexión Cosmos de entrada: configurar contra la misma cuenta y base de datos
# de Alarm Configuration Manager. El nombre físico y partition key de la
# proyección los fija el contrato compartido; no se declaran aquí.
ALARM_COSMOS_ENDPOINT=<alarm-cosmos-endpoint>
ALARM_COSMOS_KEY=<alarm-cosmos-key>
ALARM_COSMOS_DATABASE_NAME=<alarm-cosmos-database>

# Source Key contractual: alarm-configuration, definido por domain/alarms.
# No se configura de forma manual para evitar inconsistencias entre procesos.

# Evidencia manual de qualification ya revisada. Ruta absoluta, nunca se
# genera ni se supone válida automáticamente; productor sigue fuera de C2.
ALARM_QUALIFICATIONS_FILE=<absolute-qualified-evidence-file>

# Intervalo independiente del polling del scheduler y de los demás procesos.
ALARM_MATERIALIZATION_POLL_SECONDS=30

# Logs locales independientes de la telemetría Azure.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim
APPLICATION_INSIGHTS_CONNECTION_STRING=
