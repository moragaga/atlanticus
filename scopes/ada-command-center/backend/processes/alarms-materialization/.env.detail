# Plantilla de configuración local de Alarm Materialization.
# Crear un .env local y sustituir los marcadores <...>; no confirmar secretos en Git.
# En otros ambientes, ENVIRONMENT y la configuración se entregan por despliegue.
ENVIRONMENT=local

# Identidad corporativa requerida únicamente cuando se utiliza Key Vault.
COMPANY_ABREV=<company-abrev>
PRODUCT_ABREV=<product-abrev>

# Identidad exclusiva de este proceso, no de Engine ni de Delivery.
APPLICATION=ada-command-center-alarms-materialization-local

# Raíz absoluta del volumen compartido por los tres procesos.
VOLUMEN_PATH=<absolute-shared-volume-path>

# Origen de la proyección de configuración de alarmas.
ALARM_COSMOS_ENDPOINT=<alarm-cosmos-endpoint>
ALARM_COSMOS_KEY=<alarm-cosmos-key>
ALARM_COSMOS_DATABASE_NAME=<alarm-cosmos-database>
ALARM_PROJECTION_CONTAINER=<alarm-projection-container>

# Clave de Source que deben compartir Materialization, Engine y Delivery.
ALARM_CONFIGURATION_SOURCE_KEY=<materialization-source-key>

# Evidencia de qualification existente y revisada: ruta absoluta, no se genera automáticamente.
ALARM_QUALIFICATIONS_FILE=<absolute-qualified-evidence-file>

# Sondeo dentro del proceso, en segundos; no define la periodicidad del scheduler.
ALARM_MATERIALIZATION_POLL_SECONDS=30

# Configuración de observabilidad; no habilitar exportación sin credenciales.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim
APPLICATION_INSIGHTS_CONNECTION_STRING=
