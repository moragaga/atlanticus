# Plantilla local de Alarm Runtime. Copiar a .env y sustituir marcadores <...>.
# Para ambientes remotos inyectar los valores por despliegue y secretos autorizados.
ENVIRONMENT=local

# Identidad corporativa requerida solo cuando se usa Key Vault.
COMPANY_ABREV=<company-abrev>
PRODUCT_ABREV=<product-abrev>

# APPLICATION común a los tres procesos de alarmas; job_key de Runtime es independiente.
APPLICATION=ada-command-center

# El desarrollador/operador define el volumen absoluto; debe ser físicamente
# compartido con Materialization y Delivery para READY, EFFECTIVE y WAL.
VOLUMEN_PATH=<absolute-shared-volume-path>

# Source Key común alarm-configuration proviene de domain/alarms, no del .env.

# Proveedor y aplicación de la fuente PI; son configuraciones propias del entorno.
PI_SOURCE=NOTPII
PI_APPLICATION=operational-data-notpii-local

# Productores opcionales: dejar sin valor cuando no existan en este despliegue.
DISPATCH_APPLICATION=
BLOCKGRADE_APPLICATION=
REMANENTES_APPLICATION=
FABRICA_PLANES_APPLICATION=

# Evidencia técnica aprobada: no reemplazar por el contrato de ejemplo.
ALARM_TECHNICAL_EVIDENCE_CONTRACT_KEY=<approved-technical-contract-key>
ALARM_TECHNICAL_EVIDENCE_CONTRACT_VERSION=<approved-technical-contract-version>

# Polling propio de Runtime; no define frecuencia de Materialization ni Delivery.
ALARM_RUNTIME_POLL_SECONDS=5

# Logs locales y telemetría Azure separados.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim
APPLICATION_INSIGHTS_CONNECTION_STRING=
