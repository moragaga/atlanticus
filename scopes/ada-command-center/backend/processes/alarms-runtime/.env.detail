# Plantilla de configuración para la aplicación distribuible Alarm Runtime.
# Copiar a .env solo en local; reemplazar todos los valores entre <...>.
# En dev/uat/stg/prd, ENVIRONMENT y valores se inyectan por despliegue/manifiesto/Key Vault.

# Ambiente de ejecución. El archivo local .env solo puede seleccionar local.
ENVIRONMENT=local

# Necesarios en despliegue únicamente cuando el manifiesto utiliza Key Vault.
COMPANY_ABREV=<company-abrev>
PRODUCT_ABREV=<product-abrev>

# APPLICATION propia de Alarm Runtime. Es independiente de la APPLICATION de las fuentes.
APPLICATION=ada-command-center-alarms-runtime-local

# Raíz absoluta y compartida del volumen. Alarm Materialization y Alarm Runtime
# deben observar el mismo almacenamiento para READY, EFFECTIVE y WAL del Engine.
VOLUMEN_PATH=<absolute-shared-volume-path>

# Debe coincidir exactamente con ALARM_CONFIGURATION_SOURCE_KEY de Alarm Materialization.
# No se deduce desde el último READY ni desde la APPLICATION del proceso.
ALARM_CONFIGURATION_SOURCE_KEY=<materialization-source-key>

# Proveedor para PI: NOTPII o PI_WEB_API. Este valor selecciona el binding registrado.
PI_SOURCE=NOTPII

# APPLICATION del productor PI elegido. Este ejemplo corresponde a NOTPII local,
# pero debe verificarse contra la configuración del productor en cada despliegue.
PI_APPLICATION=operational-data-notpii-local

# Aplicaciones productoras opcionales. Dejar vacías si no están desplegadas.
# Una alarma que necesite una fuente sin ruta no puede consumirla correctamente.
DISPATCH_APPLICATION=
BLOCKGRADE_APPLICATION=
REMANENTES_APPLICATION=
FABRICA_PLANES_APPLICATION=

# Contrato de evidencia técnica para evaluaciones ERROR. No usar el contrato
# del evaluador de ejemplo; registrar aquí la pareja contractual aprobada.
ALARM_TECHNICAL_EVIDENCE_CONTRACT_KEY=<approved-technical-contract-key>
ALARM_TECHNICAL_EVIDENCE_CONTRACT_VERSION=<approved-technical-contract-version>

# Intervalo de ejecución, en segundos: número finito positivo; default 5.
# La espera inicial sin READY/EFFECTIVE válido sigue siendo de 30 segundos.
ALARM_RUNTIME_POLL_SECONDS=5

# Logs locales, con valores 1/true/yes/on o 0/false/no/off.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true

# Exportación a Azure: off, preview o export. export requiere Application Insights.
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off

# Perfil de telemetría: slim o diagnostic.
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim

# Secreto sensible solo cuando Azure Observatory necesita exportación.
APPLICATION_INSIGHTS_CONNECTION_STRING=
