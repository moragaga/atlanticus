# Plantilla local: copiar a .env. El despliegue remoto inyecta su configuración.
ENVIRONMENT=local

# APPLICATION es común a los procesos del flujo de alarmas.
APPLICATION=ada-command-center

# Raíz absoluta compartida por Materialization, Runtime, Modeler y Delivery.
VOLUMEN_PATH=<absolute-shared-volume-path>

# Sondeo y concurrencia autónomos de Delivery.
ALARM_DELIVERY_POLL_SECONDS=5
ALARM_DELIVERY_MAX_WORKERS=2

# Key Vault: estos identificadores solo se usan si hay secretos desplegados.
COMPANY_ABREV=<company-abrev>
PRODUCT_ABREV=<product-abrev>

# config/connections.json usa directamente tool_key como clave.
# Cada Tool resuelve endpoint, database y credential desde variables de entorno.
# El contenedor es contractual y fijo: alarm-live-projection.
ALARM_TOOL_EXAMPLE_COSMOS_ENDPOINT=<cosmos-endpoint>
ALARM_TOOL_EXAMPLE_COSMOS_DATABASE_NAME=<cosmos-database>
ALARM_TOOL_EXAMPLE_COSMOS_KEY=<cosmos-key>

ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=
APPLICATION_INSIGHTS_CONNECTION_STRING=
