# Plantilla para Alarm Delivery. Crear .env local a partir de esta plantilla.
# En otros ambientes, la identidad y los valores deben configurarse mediante despliegue.
ENVIRONMENT=local
# Identidad propia del job, distinta de Engine y Materialization.
APPLICATION=ada-command-center-alarms-delivery-local
# Volumen físico absoluto compartido con Engine y Materialization.
VOLUMEN_PATH=<absolute-shared-volume-path>
# Identificador de la misma configuración utilizada por Engine y Materialization.
ALARM_CONFIGURATION_SOURCE_KEY=<materialization-source-key>
# Frecuencia independiente de lectura de Delivery (segundos).
ALARM_DELIVERY_POLL_SECONDS=5
# Cantidad máxima de nuevos lotes durables recibidos en cada iteración de Delivery.
ALARM_DELIVERY_MAX_FACTS_PER_ITERATION=100
# Número máximo de publicaciones Cosmos concurrentes, inicialmente dos.
ALARM_DELIVERY_MAX_WORKERS=2
# Identificadores para resolver Key Vault cuando existan secretos desplegados.
COMPANY_ABREV=<company-abrev>
PRODUCT_ABREV=<product-abrev>
# Los nombres y referencias Cosmos se declaran en config/connections.json.
# Las variables referenciadas allí se definen en .env local o en secrets.json desplegado.
# Los logs técnicos están separados de la telemetría Azure.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off
# Sólo se usa cuando está habilitada la telemetría Azure.
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=
APPLICATION_INSIGHTS_CONNECTION_STRING=
