# Plantilla local: copiar a .env. El despliegue remoto inyecta su configuración.
ENVIRONMENT=local

# APPLICATION es común a los tres procesos; Delivery mantiene job_key y lease propios.
APPLICATION=ada-command-center

# Raíz absoluta administrada por el desarrollador/operador, montada sobre el
# mismo almacenamiento físico que usan Materialization y Runtime.
VOLUMEN_PATH=<absolute-shared-volume-path>

# Source Key común alarm-configuration se deriva de domain/alarms, nunca de .env.

# Sondeo, batch y concurrencia autónomos de Delivery.
ALARM_DELIVERY_POLL_SECONDS=5
ALARM_DELIVERY_MAX_FACTS_PER_ITERATION=100
ALARM_DELIVERY_MAX_WORKERS=2

# Key Vault: estos identificadores solo se usan si hay secretos desplegados.
COMPANY_ABREV=<company-abrev>
PRODUCT_ABREV=<product-abrev>

# Las conexiones Cosmos de publicación se declaran en config/connections.json;
# las variables referenciadas se suministran por .env o secrets.json desplegado.
# No usar aquí el contenedor fijo de la proyección de configuración de alarmas.

# Logs locales y telemetría Azure separados.
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=
APPLICATION_INSIGHTS_CONNECTION_STRING=
